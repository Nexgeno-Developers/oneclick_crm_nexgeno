# ==============================================================================
# PERFEX CRM - STANDARD PRODUCTION & DEVELOPMENT .GITIGNORE
# Universal template for all Nexgeno Perfex CRM projects
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Local Credentials & Database Configuration (NEVER COMMIT)
# ------------------------------------------------------------------------------
/application/config/app-config.php
/application/config/app-config.php.bak
/application/config/app-config.php.*
.env
.env.*

# ------------------------------------------------------------------------------
# 2. Logs, Cache & Error Output
# ------------------------------------------------------------------------------
/application/logs/*
!/application/logs/index.html
/application/cache/*
!/application/cache/index.html
!/application/cache/.htaccess
error_log
*.log
npm-debug.log*
yarn-error.log
pnpm-debug.log*

# ------------------------------------------------------------------------------
# 3. CodeIgniter Sessions & Temporary Files
# ------------------------------------------------------------------------------
ci_sessions/
/ci_sessions/
/temp/*
!/temp/index.html
!/temp/.htaccess
/temfile/
/tmp/

# ------------------------------------------------------------------------------
# 4. Installation & Setup Directories (Security Hazard in Production)
# ------------------------------------------------------------------------------
/install/
/install*/

# ------------------------------------------------------------------------------
# 5. User Uploads & Media Files (Preserve structure, ignore customer data)
# ------------------------------------------------------------------------------
/uploads/**
!/uploads/**/
!/uploads/**/index.html
!/uploads/**/.htaccess

# Module-specific uploads
/modules/*/uploads/**
!/modules/*/uploads/**/
!/modules/*/uploads/**/index.html
!/modules/*/uploads/**/.htaccess

# Perfex Media Manager
/media/**
!/media/**/
!/media/**/index.html

# ------------------------------------------------------------------------------
# 6. Database Backups, SQL Dumps & Spreadsheets
# ------------------------------------------------------------------------------
*.sql
!/backups/*.sql
*.zip
*.tar
*.tar.gz
*.gz
*.7z
*.rar
*.xlsx
*.xls
*.csv

# ------------------------------------------------------------------------------
# 7. Dependencies & Vendor Directories
# ------------------------------------------------------------------------------
# Ignore core Composer vendor (installed on server / managed via composer)
/application/vendor/
# Allow standalone custom module vendor directories if packaged together
!/modules/*/vendor/
/node_modules/

# Lock files (Keep composer.lock & package-lock.json for reproducible builds)
*.lock
!composer.lock
!package-lock.json

# ------------------------------------------------------------------------------
# 8. Server & Deployment Overrides
# ------------------------------------------------------------------------------
/.htaccess.*

# ------------------------------------------------------------------------------
# 9. Operating System & IDE / Editor Artifacts
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# IDEs
.idea/
*.sublime-project
*.sublime-workspace
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json

# AI Assistant Scratch & Worktree Directories (Prevent rogue worktrees)
.kilo/
.cursor/
scratch/

# ------------------------------------------------------------------------------
# 10. AI Agents & Team Standards (ALWAYS TRACKED)
# ------------------------------------------------------------------------------
# Explicitly ensure team skills, agent rules, and AGENTS.md are tracked across all forks
!.agents/
!.agents/**
!AGENTS.md
