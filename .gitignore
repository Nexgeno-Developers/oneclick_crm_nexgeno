# Local credentials and encryption key
/application/config/app-config.php
/application/config/app-config.php.bak

# Logs and cache
/application/logs/*
!/application/logs/index.html
/application/cache/*
!/application/cache/index.html
!/application/cache/.htaccess
error_log
*.log
npm-debug.log*
yarn-error.log

# CodeIgniter session files
ci_sessions/
/ci_sessions/

# Temp (Perfex temporary folder)
/temp/*
!/temp/index.html
!/temp/.htaccess

# Installation directories (Perfex CRM setup folders)
/install/
/install*/

# Uploads: keep folder structure, ignore uploaded files
/uploads/**
!/uploads/**/
!/uploads/**/index.html
!/uploads/**/.htaccess

# Module uploads
/modules/*/uploads/**
!/modules/*/uploads/**/
!/modules/*/uploads/**/index.html

# Local backups, archives, database dumps, and data spreadsheets
*.sql
!/backups/*.sql
*.zip
*.tar.gz
*.xlsx
*.xls

# Lock files (preserve composer.lock & package-lock.json for consistent builds)
*.lock
!composer.lock
!package-lock.json

# Local server / htaccess backups
/.htaccess.*

# Dependencies and OS
/node_modules
.DS_Store
Thumbs.db

# Note: .agents/ is intentionally NOT ignored so team skills, prompts, and MCP configurations are tracked.

